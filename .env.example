# UGMF runs on bundled seed data until these are set.
# Each provider switches over independently — you can wire one without the other.

# --- Spotify (artists, top tracks, followers) -------------------------------
# https://developer.spotify.com/dashboard — create an app, copy the credentials.
# UGMF uses the client-credentials flow (no user login required).
# NOTE: Spotify does NOT expose monthly listeners via the Web API. With these
# set, artists carry `followers` + `popularity` and the obscurity score falls
# back to those signals automatically.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Ticketmaster (live events, venues) -------------------------------------
# https://developer-acct.ticketmaster.com/ — "Consumer Key" from your app.
TICKETMASTER_API_KEY=
